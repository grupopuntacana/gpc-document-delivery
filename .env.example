# Example environment for local / hybrid runs. Copy to `.env` (gitignored) and fill in.
# Secrets resolve through credstore.js's env fallback, so no BTP services are needed locally.

# HMAC secret for sharing tokens. MUST be byte-identical to the Python side or every
# existing token breaks (see CLAUDE.md). Required for a useful local boot (64 chars).
SHARED_LINK_SECRET=

# OpenText folder node the portal LISTS from.
# Defaults to 2000 (Enterprise root) if unset; the deployed app uses the "Demo Documents"
# folder node. Our service user (felix.gpc) can only write where it has "Add Items" rights.
OPENTEXT_FOLDER_ID=5816

# Bucket registry: which OpenText folder each ingest bucket writes to (task 0005).
# `uploadDocument` requires a `bucket` and has NO default folder — an unconfigured or
# missing bucket is rejected 400, so this must be set for any upload to work.
#
# The portal SPA uploads to `invoices` (app/frontend/src/cap.js, override with
# VITE_INGEST_BUCKET). Keep that bucket's folderNode EQUAL to OPENTEXT_FOLDER_ID above —
# the portal lists from OPENTEXT_FOLDER_ID, so a different node means an upload succeeds
# but never appears in the listing.
# A bucket names its folder one of two ways, never both: `folderNode` for a folder an
# operator provisioned by hand, or `parentNode` + `folderName` to have the bucket create
# its own folder on first upload (task 0006).
#
# `allowedWriters` is a third, orthogonal key: the writer ACL (task 0007), listing the OAuth
# `azp` values allowed to write that bucket. Omitting it makes the bucket accept NO writers —
# there is no wildcard. A caller's real azp shows up in the denial log line, or in its own
# decoded JWT payload; the placeholders below are deliberately fake so nobody ships a
# wrong-but-plausible id.
#
# Local runs: `local-dev-caller-admin` is a working value, not a to-do. `.cdsrc.json` gives it
# to the mock user `admin` (password `admin`) under the hybrid profile — the identity the
# portal's login dialog asks for — so `cp .env.example .env` plus `npm run watch:hybrid`
# exercises the real authorization path (azp -> mayWrite -> 200). The mock user `alice` carries
# `local-dev-caller-alice` instead; grant it here too if you drive ingest from Insomnia/curl or
# the standalone `:5173` SPA. Only `invoices` grants anything: `statements` keeps a fake azp on
# purpose, so the cross-bucket 403 that task 0007 exists to enforce stays verifiable locally.
# Signature/IAS validation is NOT exercised — for that, bind a real IAS instance. On BTP the
# real azp values arrive as an env var; never commit them.
OPENTEXT_BUCKETS={"invoices":{"folderNode":5816,"allowedWriters":["local-dev-caller-admin"]},"statements":{"parentNode":5816,"folderName":"statements","allowedWriters":["replace-with-real-azp"]}}

# Delivery mode: `stream` (Option A, PDF bytes) or `cdn` (Option B, 302 to CloudFront).
# OPENTEXT_DELIVERY_MODE=stream
