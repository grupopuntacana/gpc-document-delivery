# Example environment for local / hybrid runs. Copy to `.env` (gitignored) and fill in.
# Secrets resolve through credstore.js's env fallback, so no BTP services are needed locally.

# HMAC secret for sharing tokens. MUST be byte-identical to the Python side or every
# existing token breaks (see CLAUDE.md). Required for a useful local boot (64 chars).
SHARED_LINK_SECRET=

# OpenText folder node the portal lists and ingest uploads into.
# Defaults to 2000 (Enterprise root) if unset; the deployed app uses the "Demo Documents"
# folder node. Our service user (felix.gpc) can only write where it has "Add Items" rights.
OPENTEXT_FOLDER_ID=5816

# Optional: separate folder for uploads (falls back to OPENTEXT_FOLDER_ID, then 2000).
# OPENTEXT_INGEST_FOLDER_ID=

# Delivery mode: `stream` (Option A, PDF bytes) or `cdn` (Option B, 302 to CloudFront).
# OPENTEXT_DELIVERY_MODE=stream
