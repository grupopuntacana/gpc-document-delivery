_schema-version: 3.3.0
# MTA extension descriptor for the validation phase (Credential Store deferred).
#
# Copy to `secrets.mtaext` (gitignored), fill in the real value, and deploy with:
#   mbt build
#   cf deploy mta_archives/document-delivery_1.0.0.mtar -e secrets.mtaext
#
# This sets SHARED_LINK_SECRET as an app env var, which credstore.js reads via its
# env fallback. Must be byte-identical to the Python .env value (64 chars) or every
# existing sharing token breaks. When the Credential Store is added later, remove this.
ID: document-delivery.secrets
extends: document-delivery
modules:
  - name: document-delivery-srv
    properties:
      SHARED_LINK_SECRET: "<paste the 64-char shared secret here>"
      # Note: OPENTEXT_FOLDER_ID is non-secret config and lives in mta.yaml, not here.
      #
      # OPENTEXT_BUCKETS — the per-app writer ACL. Set it HERE (in the deployable descriptor),
      # not via `cf set-env`: an imperative env var is reverted to the mta.yaml placeholder on
      # every redeploy, because it is not part of what gets deployed. Declaring it here overrides
      # the mta.yaml default and survives redeploys.
      #
      # Each bucket has two ACLs (ADR 0008, S3 PutObject vs GetObject): `allowedWriters` = azps
      # that ingest/claim, `allowedReaders` = azps that read back and mint links. A writer
      # implies read; a reader does not imply write — this is how a doc uploaded by app X is
      # delivered by app Y (X a writer, Y a reader of the same bucket). No wildcard: a bucket
      # with no allowedWriters accepts no writers, with no allowedReaders grants read only to its
      # writers. Read a caller's real azp from the denial log ("denied for azp ...") or its
      # decoded token; never guess it. `folderNode` is the OTCS folder the bucket maps to.
      #   - invoices:            portal SPA writes (frontend OIDC azp); a notifier app could read
      #   - onboard-partner-docs: onboard's intake docs (onboard's caller azp as writer)
      # NOTE (parked redesign): onboard currently calls with the DOCUMENT_SERVICE destination's
      # azp, not onboard's own onboard-ias identity — put whatever azp the denial log shows here
      # for now; the redesign is to have onboard call with its OWN named azp.
      OPENTEXT_BUCKETS: '{"invoices":{"folderNode":5816,"allowedWriters":["<frontend-oidc-azp>"],"allowedReaders":["<notifier-app-azp>"]},"onboard-partner-docs":{"folderNode":5816,"allowedWriters":["<onboard-caller-azp>"]}}'
