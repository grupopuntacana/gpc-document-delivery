{
  "authenticationMethod": "route",
  "routes": [
    {
      "source": "^/rest/(.*)$",
      "target": "/rest/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/?odata/(.*)$",
      "target": "/odata/$1",
      "destination": "srv-api",
      "csrfProtection": false
    },
    {
      "source": "^/invoice/(.*)$",
      "target": "/invoice/$1",
      "destination": "srv-api",
      "authenticationType": "none",
      "csrfProtection": false
    },
    {
      "source": "^/assets/(.*)$",
      "target": "/assets/$1",
      "service": "app-front",
      "authenticationType": "none"
    },
    {
      "source": "^(.*)$",
      "target": "/index.html",
      "service": "app-front",
      "cacheControl": "no-cache, no-store, must-revalidate"
    }
  ]
}
