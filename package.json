{
  "name": "document-delivery",
  "version": "1.0.0",
  "description": "GPC Document Delivery — CAP app on BTP. Verifies HMAC sharing tokens and serves OpenText PDFs via CloudFront. Milestone 1: Credential Store + Destination Service spike.",
  "private": true,
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1075.0",
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4",
    "@sap-cloud-sdk/http-client": "^4",
    "@sap/cds": "^9",
    "@sap/xsenv": "^5",
    "@sap/xssec": "^4",
    "form-data": "^4",
    "jose": "^5"
  },
  "devDependencies": {
    "@cap-js/cds-test": "^1.0.1",
    "@cap-js/sqlite": "^2.4",
    "@sap/cds-dk": "^9",
    "@sap/eslint-plugin-cds": "^4",
    "eslint": "^9.39.4",
    "eslint-config-airbnb-extended": "^3.1.0",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "start": "cds-serve",
    "watch": "cds watch",
    "watch:hybrid": "cds watch --profile hybrid",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "overrides": {
    "@eslint/js": "^9"
  },
  "cds": {
    "server": {
      "body_parser": {
        "limit": "30mb"
      }
    },
    "requires": {
      "app-front": true,
      "destinations": true,
      "[production]": {
        "auth": "ias"
      }
    }
  }
}
